Options -Indexes

# -------------------------------------------------------
# Redireciona URLs antigos .html para .php
# Garante que links salvos/indexados continuem funcionando
# -------------------------------------------------------
RewriteEngine On

# O jogo Unity (WebGL) é servido como arquivos estáticos.
# Esta linha impede QUALQUER reescrita dentro de /jogo/ (incluindo .html → .php).
RewriteRule ^jogo/ - [L]

# Se o arquivo .php existir, redireciona .html → .php (301 permanente)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)\.html$ /$1.php [R=301,L]

# Alternativa: se o .html foi acessado diretamente mas existe .php equivalente
RewriteCond %{REQUEST_URI} \.html$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f
RewriteCond %{DOCUMENT_ROOT}/%1.php -f
RewriteRule ^(.+)\.html$ /$1.php [R=301,L]

# -------------------------------------------------------
# Força HTTPS em produção
# -------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -------------------------------------------------------
# Headers de segurança
# -------------------------------------------------------
<IfModule mod_headers.c>
    # Impede que o site seja carregado em iframe (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Impede o browser de "adivinhar" o tipo do arquivo
    Header always set X-Content-Type-Options "nosniff"
    # Não envia a URL de origem em links externos
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Remove o header que expõe que o servidor é Apache
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# -------------------------------------------------------
# Segurança: bloqueia acesso direto a arquivos sensíveis
# -------------------------------------------------------
<FilesMatch "\.(sql|log|env|sh|py|git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files "conexao.php">
    Order allow,deny
    Deny from all
</Files>

# Bloqueia páginas de teste/depuração (caso subam sem querer)
<FilesMatch "^teste.*\.(html|php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloqueia toda a pasta de scripts do banco (database/)
RewriteRule ^database/ - [F,L]

# -------------------------------------------------------
# PHP como padrão para extensão .php
# -------------------------------------------------------
AddType application/x-httpd-php .php
